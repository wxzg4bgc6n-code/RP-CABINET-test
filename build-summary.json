{
  "output": "RP_CABINET_v98_USAF_LAW_EXAM",
  "testVersion": 98,
  "label": "USAF UAK/PK guide and exam",
  "storage": {
    "provider": "Google Drive",
    "scope": "https://www.googleapis.com/auth/drive.file",
    "folders": [
      "RP CABINET/Скриншоты",
      "RP CABINET/Отчёты",
      "RP CABINET/Аватар"
    ],
    "oldVercelBlobClientRemoved": true,
    "oldProofServiceRemoved": true,
    "binaryDataInFirebase": false,
    "tokenStorage": "memory + sessionStorage"
  },
  "screenshots": {
    "countLimit": null,
    "maxFileBytes": 15728640,
    "formats": [
      "png",
      "jpeg",
      "webp"
    ],
    "publicPermission": "anyone reader, allowFileDiscovery=false",
    "cleanupDays": 8,
    "permanentDelete": true,
    "manualDeleteRemovesDriveFileImmediately": true,
    "clientOptimization": "WebP quality 0.84, maximum dimension 2560px",
    "immediateLocalPreview": true,
    "viewer": "in-panel fullscreen lightbox",
    "directDownloadOnClick": false,
    "bulkDelete": true,
    "bulkDeleteConcurrency": 4,
    "bulkDeleteKeepsFailedFiles": true,
    "bulkDeleteInvalidatesActiveReport": true,
    "missingDriveFileRemovesLocalRecord": true,
    "perFileDeleteAlwaysVisible": true
  },
  "reports": {
    "manifestVersion": 3,
    "manifestProvider": "Google Drive",
    "viewer": "report.html",
    "anonymousView": true,
    "panelNavigation": false,
    "inlineImages": true,
    "lightbox": true,
    "requestTimeoutMs": 12000,
    "maxAttempts": 2,
    "bootWatchdogMs": 26000,
    "listImageSource": "Google Drive thumbnail 1100px",
    "fullscreenImageSource": "Google Drive thumbnail 2400px",
    "mediaUrlRole": "fallback only",
    "profileAvatarFallbackOrder": [
      "Drive thumbnail",
      "Drive media URL",
      "Google profile photo",
      "initials"
    ],
    "preconnectDrive": true
  },
  "avatar": {
    "provider": "Google Drive",
    "activeFilesPerProfile": 1,
    "format": "webp",
    "size": "512x512",
    "replaceThenDeleteOld": true,
    "cleanupExcluded": true,
    "editorPlacement": "pencil overlay on profile avatar",
    "settingsCardRemoved": true,
    "cropEditor": {
      "zoomRange": "1x-3x",
      "dragPosition": true,
      "output": "512x512 WebP",
      "frameClipping": true
    },
    "stableDomImage": true,
    "immediateLocalPreview": true,
    "fallbacks": [
      "Google photoURL",
      "profile initials"
    ]
  },
  "sync": {
    "architecture": "Firebase canonical document + onSnapshot + field-level updates + Firestore IndexedDB",
    "engine": "js/core/realtime-state.js",
    "cloudProfile": "users/{uid}/profiles/default_realtime",
    "driveMetadataSynced": true,
    "driveTokenSynced": false,
    "pageLoadWritesState": false
  },
  "smartSearch": {
    "defaultScope": "current profile organization and section",
    "mobilePlacement": "inside bottom navigation",
    "mobileFilterMode": "full remaining 100dvh height",
    "singleLauncher": true,
    "duplicateMaterialsButtonRemoved": true
  },
  "usafLawGuide": {
    "location": "after quick reports and before USAF ten-codes",
    "automaticMaterialOrder": "current progress task order",
    "missingMaterialRule": "skip task without exact source",
    "manualPinsOverrideAutomatic": true,
    "examSummary": true
  },
  "usafLawExam": {
    "questionCount": 20,
    "questionOrder": "same as supplied screenshots",
    "removeDuplicates": false,
    "answerDisplay": "correct options highlighted with active theme",
    "dataSource": "data/usaf/law-data.js",
    "templatePatch": "data/usaf/law-exam.js",
    "automaticPromotionMaterials": [
      "usaf-law",
      "usaf-test-mp-uak-pk"
    ]
  },
  "tests": [
    "_tools/test-v98-usaf-law-exam.mjs",
    "node --check for all JavaScript",
    "HTML dependency audit",
    "ZIP integrity audit"
  ],
  "githubRoot": [
    "index.html",
    "report.html",
    "assets",
    "css",
    "data",
    "js",
    "documentation",
    "_tools",
    "README.md",
    "build-summary.json"
  ]
}
