{
  "output": "RP_CABINET_v94_AVATAR_OVERLAY_SEARCH_CLEANUP",
  "testVersion": 94,
  "label": "Avatar editor and search cleanup",
  "storage": {
    "provider": "Google Drive",
    "scope": "https://www.googleapis.com/auth/drive.file",
